# Functions admin runtime configuration. Values below are non-secret placeholders.
# Use an untracked environment file or deployment environment configuration per project.
# Do not put ADMIN_RATE_LIMIT_KEY or ADMIN_AUDIT_HMAC_KEY here: they are separate
# Firebase Secret Manager secrets. See the admin deployment runbook for rotation.
# Non-secret deploy-time service account email for admin callables.
ADMIN_RUNTIME_SERVICE_ACCOUNT=admin-callables@replace-with-firebase-project-id.iam.gserviceaccount.com
# Non-secret deploy-time service account email for invite callables and cleanup.
INVITE_RUNTIME_SERVICE_ACCOUNT=invite-callables@replace-with-firebase-project-id.iam.gserviceaccount.com

ADMIN_EXPECTED_PROJECT_ID=replace-with-firebase-project-id
ADMIN_ALLOWED_APP_IDS=1:000000000000:web:replace-with-admin-web-app-id
ADMIN_ENVIRONMENT=development
ADMIN_POLICY_VERSION=replace-with-policy-version
ADMIN_ALLOWED_SIGN_IN_PROVIDERS=password
ADMIN_ALLOWED_TENANTS=none
ADMIN_ALLOWED_SECOND_FACTORS=none
ADMIN_ALLOWED_ORIGINS=https://admin.example.invalid
ADMIN_RATE_LIMIT_KEY_VERSION=replace-with-rate-limit-key-version
ADMIN_AUDIT_HMAC_KEY_VERSION=replace-with-audit-hmac-key-version
ADMIN_API_VERSION=v1
