rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null
        && 'firebase' in request.auth.token
        && request.auth.token.firebase is map
        && 'sign_in_provider' in request.auth.token.firebase
        && request.auth.token.firebase.sign_in_provider in [
          'password',
          'google.com',
          'apple.com',
        ];
    }
    function isAccountFrozen(uid) {
      return (
          firestore.exists(/databases/(default)/documents/users/$(uid))
          && firestore.get(
            /databases/(default)/documents/users/$(uid)
          ).data.get('accountLifecycleStatus', 'active') == 'frozen'
        )
        || (
          firestore.exists(
            /databases/(default)/documents/accountLifecycleQuarantine/$(uid)
          )
          && (
            firestore.get(
              /databases/(default)/documents/accountLifecycleQuarantine/$(uid)
            ).data.get('status', '') == 'frozen'
            || (
              firestore.get(
                /databases/(default)/documents/accountLifecycleQuarantine/$(uid)
              ).data.get('status', '') == 'quarantined'
              && firestore.get(
                /databases/(default)/documents/accountLifecycleQuarantine/$(uid)
              ).data.get('quarantineUntil', request.time) > request.time
            )
          )
        );
    }
    function isActiveConsumer() {
      return isSignedIn() && !isAccountFrozen(request.auth.uid);
    }
    function isHouseholdMember(hid) {
      return isActiveConsumer()
        && firestore.exists(
          /databases/(default)/documents/households/$(hid)/members/$(request.auth.uid)
        );
    }
    function hasFullPantryAccess(hid) {
      return isHouseholdMember(hid) && (
        firestore.get(
          /databases/(default)/documents/households/$(hid)/members/$(request.auth.uid)
        ).data.role == 'admin' ||
        firestore.get(/databases/(default)/documents/households/$(hid)).data.isJoint == false
      );
    }
    function isValidPantryImage() {
      return request.resource.size > 0
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /ingredients/{path=**} {
      allow read: if isActiveConsumer();
      allow write: if false;
    }

    // Pantry images are read by household members, while new uploads are
    // limited to the same full-pantry roles as Firestore. Emulator fixtures
    // are seeded through trusted tooling, never relaxed client rules.
    match /households/{hid}/pantry/{itemId}/{imageId} {
      allow read: if isHouseholdMember(hid);
      allow create: if resource == null
        && hasFullPantryAccess(hid)
        && isValidPantryImage();
      allow update, delete: if false;
    }
  }
}
